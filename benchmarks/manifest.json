{
  "name": "security-review-commons-baseline-benchmark",
  "comparatorArtifact": "./comparators/external-baseline.json",
  "cases": [
    {
      "id": "deterministic-app-sinks",
      "description": "Diff-local deterministic review should catch shell execution and secrets",
      "fixture": "../tests/fixtures/sample.diff",
      "changedFiles": ["src/auth/login.js"],
      "expectedRuleIds": [
        "builtin-dangerous-child-process-shell-true",
        "builtin-hardcoded-secret-token"
      ]
    },
    {
      "id": "deterministic-dom-xss",
      "description": "Deterministic review should catch request-controlled dangerouslySetInnerHTML",
      "fixture": "../tests/fixtures/js-dangerously-set-inner-html-tainted.jsx",
      "changedFiles": ["src/render-danger.jsx"],
      "expectedRuleIds": [
        "builtin-dangerously-set-inner-html-user-input"
      ]
    },
    {
      "id": "deterministic-python-deserialization",
      "description": "Deterministic review should catch Python pickle deserialization",
      "fixture": "../tests/fixtures/py-pickle-dangerous.py",
      "changedFiles": ["src/pickle-dangerous.py"],
      "expectedRuleIds": [
        "builtin-python-pickle-load"
      ]
    },
    {
      "id": "deterministic-authz-disabled",
      "description": "Deterministic review should catch disabled authorization config",
      "fixture": "../tests/fixtures/js-authz-disabled-tainted.js",
      "changedFiles": ["src/authz-disabled-tainted.js"],
      "expectedRuleIds": [
        "builtin-authz-check-disabled"
      ]
    },
    {
      "id": "deterministic-python-os-system",
      "description": "Deterministic review should catch Python os.system execution",
      "fixture": "../tests/fixtures/py-os-system-dangerous.py",
      "changedFiles": ["src/os-system-dangerous.py"],
      "expectedRuleIds": [
        "builtin-python-os-system"
      ]
    },
    {
      "id": "turn-model-auth-bypass",
      "description": "Turn review should merge findings from the configured reviewer command",
      "reviewMode": "turn",
      "fixture": "../tests/fixtures/turn-review.diff",
      "changedFiles": ["src/auth/flow.js"],
      "repoRoot": "..",
      "configFile": "../tests/fixtures/turn-review.config.json",
      "expectedRuleIds": [
        "builtin-auth-bypass-flag",
        "model-turn-review-mock-fixture"
      ]
    },
    {
      "id": "checkpoint-import-context",
      "description": "Checkpoint review should inspect imported helper context",
      "reviewMode": "checkpoint",
      "repoRoot": "../tests/fixtures/checkpoint-repo",
      "changedFiles": ["src/feature.js"],
      "layer": "commit",
      "expectedRuleIds": [
        "builtin-dangerous-child-process-shell-true"
      ]
    },
    {
      "id": "checkpoint-adjacent-auth-context",
      "description": "Checkpoint review should inspect bounded adjacent auth context",
      "reviewMode": "checkpoint",
      "repoRoot": "../tests/fixtures/checkpoint-adjacent-repo",
      "changedFiles": ["src/routes/admin.js"],
      "layer": "commit",
      "expectedRuleIds": [
        "builtin-hardcoded-secret-token"
      ]
    },
    {
      "id": "checkpoint-safe-nearby-tree",
      "description": "Checkpoint review should stay clean for unrelated nearby trees",
      "reviewMode": "checkpoint",
      "repoRoot": "../tests/fixtures/checkpoint-adjacent-safe-repo",
      "changedFiles": ["src/routes/admin.js"],
      "layer": "commit",
      "expectedRuleIds": []
    }
  ]
}
