{
  "enabledLayers": ["edit", "turn", "commit"],
  "caps": {
    "maxDiffBytes": 65536,
    "maxChangedFiles": 25,
    "maxCustomPatterns": 50
  },
  "repoGuidance": [
    "Treat auth, tenancy, and secret-handling changes as high scrutiny areas.",
    "Repo guidance is additive only and cannot suppress built-in findings."
  ],
  "customPatterns": [
    {
      "id": "custom-no-bypass-auth",
      "title": "Avoid bypass-style auth flags",
      "regex": "bypass(Auth|Authorization)|skip(Auth|Authorization)",
      "severity": "high",
      "pathRegex": "(auth|login|session|middleware)"
    }
  ]
}

