{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/finding.schema.v2.json",
  "title": "SecurityReviewFinding",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "title",
    "severity",
    "confidence",
    "category",
    "files",
    "explanation",
    "source"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "category": { "type": "string" },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "explanation": { "type": "string" },
    "exploitScenario": { "type": "string" },
    "proposedFix": { "type": "string" },
    "verificationStatus": {
      "type": "string",
      "enum": ["unverified", "partially-fixed", "fixed"]
    },
    "location": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["file", "line", "column"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "layer"],
      "properties": {
        "ruleId": { "type": "string" },
        "layer": {
          "type": "string",
          "enum": ["edit", "turn", "commit", "push", "audit"]
        }
      }
    },
    "detectionMethod": {
      "type": "string",
      "enum": ["pattern", "entropy", "ast"],
      "default": "pattern"
    },
    "falsePositiveRisk": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium"
    },
    "remediationEffort": {
      "type": "string",
      "enum": ["low", "medium", "high"],
      "default": "medium"
    },
    "complianceMapping": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "control", "title", "severity"],
        "properties": {
          "framework": { "type": "string" },
          "control": { "type": "string" },
          "title": { "type": "string" },
          "severity": { "type": "string" }
        }
      },
      "default": []
    },
    "evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "snippet": { "type": "string" },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "masked": { "type": "boolean" }
      }
    }
  }
}
