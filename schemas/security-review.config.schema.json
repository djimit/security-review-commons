{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/security-review.config.schema.json",
  "title": "SecurityReviewConfig",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabledLayers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["edit", "turn", "commit", "push"]
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxDiffBytes": { "type": "integer", "minimum": 1024 },
        "maxChangedFiles": { "type": "integer", "minimum": 1 },
        "maxCustomPatterns": { "type": "integer", "minimum": 1 },
        "maxSuppressions": { "type": "integer", "minimum": 1 }
      }
    },
    "turnReview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "minSeverityToBlock": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "maxModelDiffBytes": { "type": "integer", "minimum": 1024 },
        "maxPromptChars": { "type": "integer", "minimum": 1024 },
        "maxModelFindings": { "type": "integer", "minimum": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1000 },
        "command": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["executable"],
          "properties": {
            "executable": { "type": "string" },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "repoGuidance": {
      "type": "array",
      "items": { "type": "string" }
    },
    "customPatterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "regex", "severity"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "regex": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high", "critical"]
          },
          "pathRegex": { "type": "string" }
        }
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "owner", "justification"],
        "properties": {
          "ruleId": { "type": "string" },
          "pathRegex": { "type": "string" },
          "owner": { "type": "string" },
          "justification": { "type": "string" },
          "expiresOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
