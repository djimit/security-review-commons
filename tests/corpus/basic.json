{
  "name": "basic-security-review-corpus",
  "cases": [
    {
      "id": "app-sinks-sample",
      "description": "Sample diff catches shell execution and hardcoded credentials",
      "fixture": "./tests/fixtures/sample.diff",
      "changedFiles": ["src/auth/login.js"],
      "expectedRuleIds": [
        "builtin-dangerous-child-process-shell-true",
        "builtin-hardcoded-secret-token"
      ]
    },
    {
      "id": "workflow-dangerous",
      "description": "Workflow fixture catches trust-boundary and supply-chain drift",
      "fixture": "./tests/fixtures/workflow-dangerous.yml",
      "changedFiles": [".github/workflows/dangerous.yml"],
      "expectedRuleIds": [
        "builtin-github-actions-curl-pipe-shell",
        "builtin-github-actions-pull-request-target",
        "builtin-github-actions-write-all-permissions"
      ]
    },
    {
      "id": "docker-root-runtime",
      "description": "Dockerfile fixture catches missing non-root runtime user",
      "fixture": "./tests/fixtures/Dockerfile.root",
      "changedFiles": ["Dockerfile"],
      "expectedRuleIds": [
        "builtin-dockerfile-missing-user"
      ]
    },
    {
      "id": "kubernetes-privileged",
      "description": "Kubernetes fixture catches privileged/root execution",
      "fixture": "./tests/fixtures/k8s-privileged.yaml",
      "changedFiles": ["deploy/k8s-privileged.yaml"],
      "expectedRuleIds": [
        "builtin-kubernetes-privileged-container",
        "builtin-kubernetes-runas-root"
      ]
    },
    {
      "id": "terraform-public-ssh",
