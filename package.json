{
  "name": "@djimit/security-review-commons",
  "version": "0.2.1",
  "private": false,
  "description": "Portable, auditable code security review core with OpenCode and Codex adapters.",
  "homepage": "https://github.com/djimit/security-review-commons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djimit/security-review-commons.git"
  },
  "bugs": {
    "url": "https://github.com/djimit/security-review-commons/issues"
  },
  "author": "Dutch Dim",
  "type": "module",
  "bin": {
    "security-review-commons": "./src/cli.js"
  },
  "files": [
    ".claude-plugin/",
    "bin/",
    "hooks/",
    "src/",
    "schemas/",
    "README.md",
    "docs/",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./core/config": "./src/core/config.js",
    "./core/review": "./src/core/review.js",
    "./core/sarif": "./src/core/sarif.js",
    "./adapters/opencode": "./src/adapters/opencode/plugin.js",
    "./adapters/codex": "./src/adapters/codex/adapter.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "lint": "node --check src/index.js src/cli.js src/core/*.js src/adapters/*.js src/adapters/opencode/*.js src/adapters/codex/*.js src/plugin/*.js bin/*.js scripts/*.js",
    "corpus": "node ./src/cli.js --corpus ./tests/corpus/basic.json --strict-corpus",
    "benchmark": "node ./scripts/run-benchmark.js --manifest ./benchmarks/manifest.json --output ./benchmarks/results/baseline.json",
    "capture:batch": "node ./scripts/create-runtime-capture-batch.js",
    "capture:fixture": "node ./scripts/capture-runtime-fixture.js",
    "check": "npm run lint && npm test && npm run corpus",
    "pack:dry-run": "npm pack --dry-run"
  },
  "keywords": [
    "security",
    "code-review",
    "opencode",
    "codex",
    "plugin",
    "sarif",
    "sast"
  ],
  "license": "MIT",
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-typescript": "^1.4.13",
    "acorn-walk": "^8.3.5"
  }
}
